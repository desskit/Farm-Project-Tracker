# --- Core ---
# Public origin the app is served from (used for invite/QR links, cookies).
PUBLIC_URL=https://farm.example.com
# Domain Caddy serves + gets a TLS cert for (host only, no scheme).
PUBLIC_DOMAIN=farm.example.com
# Process timezone — set to the farm's zone so "today"/rollovers match the crew.
TZ=America/Los_Angeles

# --- Database ---
# libsql/SQLite file. In Docker this lives on the mounted /data volume.
DATABASE_URL=file:./data/app.db

# --- File storage ---
# Directory for uploaded photos/documents (mounted volume in Docker).
UPLOAD_DIR=./data/uploads

# --- Email (digests) — optional; digests are skipped if unset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Farm Tracker <farm@example.com>"

# --- Web Push (VAPID) — optional; push is skipped if unset ---
# Generate once and keep them: changing the keys invalidates every existing
# subscription, so everyone has to re-enable push on their device.
#
#   npx web-push generate-vapid-keys
#
# No npx on the host? Any of these produce the same thing:
#
#   docker run --rm node:22-alpine npx --yes web-push generate-vapid-keys
#
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey:a,privateKey:b}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('VAPID_PUBLIC_KEY='+a.export({type:'spki',format:'der'}).subarray(-65).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+Buffer.from(b.export({format:'jwk'}).d,'base64url').toString('base64url'))"
#
# The public key is 87 chars, the private key 43. No quotes — they're base64url.
# VAPID_SUBJECT must be a real mailto: you monitor; push services use it to
# reach you, and a bogus address risks rate-limiting.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- AI "Suggest steps" — optional; button hidden if unset ---
ANTHROPIC_API_KEY=

# --- Seed admin (first run only) ---
SEED_ADMIN_NAME=Dale
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme
